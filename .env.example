# Não inclua credenciais neste arquivo. Copie para .env e preencha localmente.
# Para usar .env: node --env-file=.env server.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# Produção: referência privada do serviço PostgreSQL no Railway.
# Desenvolvimento: deixe ausente para usar SQLite em .data/.
# DATABASE_URL=
PORT=3000

# Claude opcional: chave somente no backend. Ativa apenas com chave presente.
# ANTHROPIC_API_KEY=
ENABLE_AI=false
AI_MODEL=claude-sonnet-4-6

# Somente demonstração isolada, dados fictícios em memória (nunca no serviço clínico).
DEMO_MODE=false
